# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origins (comma-separated for all 3 dedicated role portals)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL Database Connection String (Prisma)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/viora_bills?schema=public"

# Session & Cookie Signing Secret (set a strong random string in production)
SESSION_SECRET="replace-with-random-64-char-secret"

# Optional Razorpay Gateway Credentials (defaults to sandbox if unset)
RAZORPAY_MODE=TEST
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
